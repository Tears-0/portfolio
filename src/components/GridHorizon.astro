---
// The 1999 data frontier: a wireframe grid receding to a vanishing point, with neon highways
// and packets streaking along them (storyboard A-3, II-1). Shared by Transition A, which
// fades it in, and Act II, which flies it toward the viewer.
import '../scenes/act-1999/grid.css';
---

<div class="grid-horizon" aria-hidden="true" data-grid>
  <div class="grid-glow"></div>
  <div class="grid-plane">
    <div class="grid-lines" data-grid-lines></div>
    <span class="grid-highway hw-1">
      <span class="grid-packet"></span>
    </span>
    <span class="grid-highway hw-2">
      <span class="grid-packet"></span>
    </span>
    <span class="grid-highway hw-3">
      <span class="grid-packet"></span>
    </span>
    <span class="grid-highway hw-4">
      <span class="grid-packet"></span>
    </span>
  </div>
</div>
