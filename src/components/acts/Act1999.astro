---
import type { CollectionEntry } from 'astro:content';
import type { SceneDef } from '../../scenes/registry';
import { STATUS_LABEL, formatPeriod } from '../../lib/content';
import { hasPlaceholder, publishMetric, publishText } from '../../lib/placeholder';
import Beat from '../Beat.astro';
import SceneLayer from '../SceneLayer.astro';

interface Props {
  scene: SceneDef;
  /** Featured projects in order; the scroll map has one rest point for each of the first four. */
  projects: CollectionEntry<'projects'>[];
}
const { scene, projects } = Astro.props;
const COMMANDS = ['ls projects', 'run cartridge_02.exe', 'stats quantization', 'help'];
---

<SceneLayer scene={scene} anchor="works" heading="1999 · Works">
  {projects.slice(0, 4).map((project, i) => {
    const { data } = project;
    const role = publishText(data.role);
    const period = formatPeriod(data.period);
    const highlight = publishMetric(data.highlight);
    return (
      <Beat scene="act-1999" beat={`project-${i + 1}`}>
        <article class="window" aria-labelledby={`project-${project.id}`}>
          <p class="window-bar" aria-hidden="true">
            cartridge_0{i + 1}.exe · {data.cartridge}
          </p>
          <h3 id={`project-${project.id}`}>{data.title}</h3>
          <p class="summary">{data.summary}</p>
          <dl class="meta">
            {role && (
              <div>
                <dt>Role</dt>
                <dd class:list={{ draft: hasPlaceholder(role) }}>{role}</dd>
              </div>
            )}
            {period && (
              <div>
                <dt>Period</dt>
                <dd class:list={{ draft: hasPlaceholder(period) }}>{period}</dd>
              </div>
            )}
            <div>
              <dt>Status</dt>
              <dd>{STATUS_LABEL[data.status]}</dd>
            </div>
          </dl>
          <ul class="tags" aria-label="Tags">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          {highlight && (
            <p class="highlight">
              <strong class:list={{ draft: hasPlaceholder(highlight.value) }}>
                {highlight.value}
              </strong>
              <span>{highlight.label}</span>
              <span class:list={['source', { draft: hasPlaceholder(highlight.source) }]}>
                Source: {highlight.source}
              </span>
            </p>
          )}
          <p class="window-actions">
            <span class="gb-button">Open case study · M3</span>
            {data.links.repo && <a href={data.links.repo}>Code</a>}
            {data.links.paper && <a href={data.links.paper}>Paper</a>}
          </p>
        </article>
      </Beat>
    );
  })}
  <Beat scene="act-1999" beat="console">
    <div class="panel console">
      <h3>Console</h3>
      <p>Free typing plus suggested commands, with answers generated from the content data.</p>
      <ul class="chips" aria-label="Suggested commands">
        {COMMANDS.map((command) => (
          <li>
            <code>{command}</code>
          </li>
        ))}
      </ul>
      <p class="gb-note" aria-hidden="true">
        Grey box until M3
      </p>
    </div>
  </Beat>
</SceneLayer>
