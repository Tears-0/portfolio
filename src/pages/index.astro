---
// The static summary: what everyone sees at / until the descent launches (M7), and what
// phones keep seeing after that. Same records as /resume and the descent.
import Email from '../components/Email.astro';
import Site from '../layouts/Site.astro';
import {
  RESUME_PDF,
  SITE_URL,
  STATUS_LABEL,
  formatPeriod,
  getEducation,
  getFeaturedProjects,
  getLabProjects,
  getPhilosophy,
  getProfile,
  getSkills,
  shortUrl,
} from '../lib/content';
import { hasPlaceholder, publishMetric, publishText } from '../lib/placeholder';

const [profile, philosophy, featured, lab, skills, education] = await Promise.all([
  getProfile(),
  getPhilosophy(),
  getFeaturedProjects(),
  getLabProjects(),
  getSkills(),
  getEducation(),
]);

const pdfName = `${profile.name.replaceAll(' ', '-')}-Resume.pdf`;
const cards = profile.cards.flatMap((card) => {
  const value = publishText(card.value);
  return value ? [{ label: card.label, value }] : [];
});
const availability = publishText(profile.availability);
const body = publishText(philosophy.body);
const origin = publishText(philosophy.origin);
const school = education[0]?.data;
const { github, linkedin, email } = profile.links;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.displayName,
  url: SITE_URL,
  jobTitle: 'Computer Science student',
  description: profile.pitch,
  address: {
    '@type': 'PostalAddress',
    addressRegion: profile.place.region,
    addressCountry: profile.place.countryCode,
  },
  ...(school && { alumniOf: { '@type': 'CollegeOrUniversity', name: school.institution } }),
  sameAs: [github, linkedin].filter(Boolean),
  knowsAbout: skills.map((s) => s.data.name),
};
---

<Site
  title={`${profile.name} (${profile.displayName}) · Applied AI and machine learning`}
  description={profile.pitch}
  jsonLd={person}
>
  <header class="intro wrap">
    <p class="mark" aria-hidden="true">
      {profile.displayName} · 2099
    </p>
    <h1>{profile.name}</h1>
    <p class="greeting">{profile.greeting}</p>
    <p class="headline">{profile.headline}</p>
    <ul class="actions">
      <li>
        <a class="button primary" href={RESUME_PDF} download={pdfName}>
          Download resume
        </a>
      </li>
      <li>
        <a class="button" href="/resume">
          View resume
        </a>
      </li>
      <li>
        <a class="button" href="#contact">
          Contact
        </a>
      </li>
    </ul>
    <dl class="facts">
      {cards.map((card) => (
        <div class="fact">
          <dt>{card.label}</dt>
          <dd class:list={{ draft: hasPlaceholder(card.value) }}>{card.value}</dd>
        </div>
      ))}
    </dl>
  </header>

  <main>
    <section class="wrap block" aria-labelledby="work-title">
      <h2 id="work-title">Selected work</h2>
      <ol class="projects">
        {featured.map((project) => {
          const { data } = project;
          const role = publishText(data.role);
          const period = formatPeriod(data.period);
          const highlight = publishMetric(data.highlight);
          const links = [
            data.links.repo && { href: data.links.repo, label: 'Code' },
            data.links.paper && { href: data.links.paper, label: 'Paper' },
            data.links.demo && { href: data.links.demo, label: 'Demo' },
          ].filter(Boolean) as { href: string; label: string }[];
          return (
            <li class="project">
              <article aria-labelledby={`project-${project.id}`}>
                <p class="project-meta">
                  {STATUS_LABEL[data.status]}
                  {period && (
                    <span class:list={{ draft: hasPlaceholder(period) }}> · {period}</span>
                  )}
                </p>
                <h3 id={`project-${project.id}`}>{data.title}</h3>
                <p>{data.summary}</p>
                {role && <p class:list={['role', { draft: hasPlaceholder(role) }]}>{role}</p>}
                {highlight && (
                  <p class="highlight">
                    <strong class:list={{ draft: hasPlaceholder(highlight.value) }}>
                      {highlight.value}
                    </strong>{' '}
                    {highlight.label}
                    <span class:list={['source', { draft: hasPlaceholder(highlight.source) }]}>
                      Source: {highlight.source}
                    </span>
                  </p>
                )}
                <ul class="tags" aria-label="Tags">
                  {data.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                {links.length > 0 && (
                  <p class="project-links">
                    {links.map((link) => (
                      <a href={link.href}>{link.label}</a>
                    ))}
                  </p>
                )}
              </article>
            </li>
          );
        })}
      </ol>
      {lab.length > 0 && (
        <>
          <h3 class="lab-title">From the lab</h3>
          <ul class="lab">
            {lab.map((project) => (
              <li>
                <strong>{project.data.title}.</strong> {project.data.summary}
              </li>
            ))}
          </ul>
        </>
      )}
    </section>

    <section class="wrap block" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills</h2>
      <p class="legend">Tiers in words: Daily, Comfortable, Familiar.</p>
      <div class="skill-groups">
        {skills.map((skill) => (
          <section class="skill-group" aria-labelledby={`skill-${skill.id}`}>
            <h3 id={`skill-${skill.id}`}>{skill.data.name}</h3>
            <ul>
              {skill.data.tools.map((tool) => (
                <li>
                  <span>{tool.name}</span>
                  <span class="tier" data-tier={tool.tier}>
                    {tool.tier}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="wrap block about" aria-labelledby="about-title">
      <h2 id="about-title">Why I build</h2>
      <blockquote class="closing">
        <p>{philosophy.closingLine}</p>
      </blockquote>
      {body && <p class:list={{ draft: hasPlaceholder(body) }}>{body}</p>}
      {origin && <p class:list={{ draft: hasPlaceholder(origin) }}>{origin}</p>}
    </section>

    <section id="contact" class="wrap block" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p>
        Target roles: {profile.targetRoles.join(', ')}.
        {availability && (
          <span class:list={{ draft: hasPlaceholder(availability) }}>{availability}.</span>
        )}
        Based in {profile.location}.
      </p>
      <ul class="contact-list">
        {email && (
          <li>
            <Email email={email} copy />
          </li>
        )}
        {github && (
          <li>
            <a href={github}>{shortUrl(github)}</a>
          </li>
        )}
        {linkedin && (
          <li>
            <a href={linkedin}>{shortUrl(linkedin)}</a>
          </li>
        )}
        <li>
          <a href={RESUME_PDF} download={pdfName}>
            Resume (PDF)
          </a>{' '}
          ·<a href="/resume">web version</a> ·<a href="/resume.json">JSON</a>
        </li>
      </ul>
    </section>
  </main>

  <footer class="wrap footer">
    <p>A scroll-driven version of this site, descending from 2099 back to 1350, is on its way.</p>
    <p>© 2026 {profile.name}</p>
  </footer>
</Site>

<style>
  .wrap {
    width: min(46rem, 100% - 2rem);
    margin-inline: auto;
  }

  .intro {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(3.5rem, 12vw, 7rem) 3rem;
  }

  /* Iridescence lives on edges and in the dark, never behind text. */
  .intro::before {
    position: absolute;
    inset: 0 auto auto 0;
    width: 4rem;
    height: 2px;
    background: var(--iridescence);
    content: '';
  }

  .mark {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--iris);
  }

  h1 {
    font-size: clamp(2.25rem, 8vw, 3.6rem);
  }

  .greeting {
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4vw, 1.75rem);
    line-height: 1.3;
  }

  .headline {
    max-width: 60ch;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-block;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 200ms var(--ease);
  }

  .button:hover {
    border-color: var(--iris);
  }

  .button.primary {
    border-color: var(--iris);
    background: var(--iris);
    color: var(--bg);
    font-weight: 600;
  }

  .facts {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  @media (width >= 36rem) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .fact {
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--glass-line);
    border-radius: 14px;
    background: var(--glass);
  }

  .fact dt,
  .project-meta,
  .legend {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .block {
    display: grid;
    gap: 1.25rem;
    padding-block: 3rem;
    border-top: 1px solid var(--glass-line);
  }

  h2 {
    font-size: 1.5rem;
  }

  .projects {
    display: grid;
    gap: 1rem;
  }

  .project article {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 1.25rem 1.25rem 1.4rem;
    border: 1px solid var(--glass-line);
    border-radius: 16px;
    background: var(--glass);
  }

  .project article::before {
    position: absolute;
    inset: -1px 1.25rem auto;
    height: 1px;
    background: var(--iridescence);
    opacity: 0.6;
    content: '';
  }

  .project h3 {
    font-size: 1.2rem;
  }

  .role {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .highlight {
    padding: 0.6rem 0.9rem;
    border-left: 2px solid var(--iris);
    background: rgb(159 231 245 / 5%);
  }

  .highlight strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .source {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags li {
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .lab-title {
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }

  .lab {
    display: grid;
    gap: 0.6rem;
    color: var(--muted);
  }

  .lab strong {
    color: var(--text);
    font-weight: 600;
  }

  .skill-groups {
    display: grid;
    gap: 1rem;
  }

  @media (width >= 44rem) {
    .skill-groups {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .skill-group {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--glass-line);
    border-radius: 16px;
  }

  .skill-group h3 {
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
  }

  .skill-group li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--glass-line);
    font-size: 0.92rem;
  }

  .skill-group li:last-child {
    border-bottom: 0;
  }

  .tier {
    flex: none;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .tier[data-tier='Daily'] {
    color: var(--iris);
  }

  .closing {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4vw, 1.7rem);
    line-height: 1.35;
    color: var(--iris);
  }

  .contact-list {
    display: grid;
    gap: 0.5rem;
  }

  .footer {
    display: grid;
    gap: 0.4rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--glass-line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media print {
    .intro {
      padding-block: 0 1rem;
    }

    .actions,
    .footer p:first-child {
      display: none;
    }

    .project article,
    .fact,
    .skill-group {
      border-color: #bbb;
      background: none;
    }

    .project article::before,
    .intro::before {
      display: none;
    }
  }
</style>
