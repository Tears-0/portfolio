{
  "name": "four-eras-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ccy's portfolio: one long scroll that descends from 2099 to 1350 through four retro-futures.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "pdf": "node scripts/build-pdf.ts",
    "pdf:private": "node scripts/build-pdf.ts --private",
    "pdf:check": "node scripts/check-pdf.ts",
    "verify": "npm run check && npm run lint && npm run format:check && npm test && npm run build && npm run test:build && npm run pdf && npm run pdf:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "astro": "^7.4.5",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
